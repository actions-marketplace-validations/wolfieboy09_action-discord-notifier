{
    "name": "@wolfieboy09/action-discord-notifier",
    "version": "1.3.1",
    "description": "Use a Discord webhook to get notifications about commits.",
    "main": "index.js",
    "scripts": {
        "bundle": "npm run format:write && npm run package",
        "ci-test": "jest",
        "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
        "format:write": "prettier --write \"./src/**/*.js\"",
        "format:check": "prettier --check \"./src/**/*.js\"",
        "package": "ncc build src/index.js -o dist --source-map --license licenses.txt",
        "package:watch": "npm run package -- --watch",
        "test": "jest",
        "all": "npm run format:write && npm test && npm run coverage && npm run package"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/wolfieboy09/action-discord-notifier.git"
    },
    "keywords": [
        "github-actions",
        "discord"
    ],
    "author": "wolfieboy09",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/wolfieboy09/action-discord-notifier/issues"
    },
    "homepage": "https://github.com/wolfieboy09/action-discord-notifier#readme",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "axios": "^1.16.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.5",
        "@vercel/ncc": "^0.38.4",
        "babel-preset-jest": "^29.6.3",
        "jest": "^30.4.1",
        "make-coverage-badge": "^1.2.0",
        "prettier": "^3.8.3"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
